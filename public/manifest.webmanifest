{
 "id": "./",
 "name": "GPB Catalogue",
 "short_name": "GPB Catalogue",
 "description": "Photograph products, straighten and cut them out, and make catalogue PDFs to share on WhatsApp.",
 "lang": "en-IN",
 "start_url": "./?source=app",
 "scope": "./",
 "display": "standalone",
 "background_color": "#1D2340",
 "theme_color": "#1D2340",
 "categories": [
  "business",
  "productivity"
 ],
 "icons": [
  {
   "src": "icons/icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icons/icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icons/maskable-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "maskable"
  },
  {
   "src": "icons/maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "shortcuts": [
  {
   "name": "Add products",
   "short_name": "Add",
   "url": "./?action=add",
   "icons": [
    {
     "src": "icons/shortcut-add.png",
     "sizes": "96x96",
     "type": "image/png"
    }
   ]
  },
  {
   "name": "Make a catalogue",
   "short_name": "Catalogue",
   "url": "./?action=catalogue",
   "icons": [
    {
     "src": "icons/shortcut-catalogue.png",
     "sizes": "96x96",
     "type": "image/png"
    }
   ]
  }
 ],
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "files": [
    {
     "name": "files",
     "accept": [
      "image/*",
      "text/csv",
      "text/comma-separated-values",
      ".csv",
      "application/zip",
      ".zip"
     ]
    }
   ]
  }
 }
}